# Required for Docker Compose. Fill both secret values before starting.
DB_USER=wishlist
DB_NAME=wishlist
DB_PASSWORD=
SECRET_KEY=
ALGORITHM=HS256

# Published loopback ports.
API_PORT=8000
UI_PORT=5173

# Used by the API when run directly on the host.
DB_HOST=localhost
DB_SSLMODE=disable
REDIS_URL=redis://localhost:6379/0
